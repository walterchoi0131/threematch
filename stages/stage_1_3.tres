[sub_resource type="Resource" id="post_clear"]
script = ExtResource("2_dline")
text_zh = "最後一名爪牙倒下。聖所再次安靜下來，但祭壇上留下了 Owen 的印記。"
text_en = "The last minion falls. The sanctuary is quiet again, but the altar bears the mark of Owen."
music = ExtResource("9_music")

[sub_resource type="Resource" id="post_duan"]
script = ExtResource("2_dline")
character_id = "duan"
position = "right"
text_zh = "他們不是隨便襲擊這裡。他們在找祭壇底下的某樣東西。"
text_en = "They were not raiding at random. They were searching for something under the altar."
action = "enter"

[sub_resource type="Resource" id="post_dragon"]
script = ExtResource("2_dline")
character_id = "dragon"
text_zh = "可是證書還在！"
text_en = "But the certificates are still here!"
action = "enter"

[sub_resource type="Resource" id="post_shark"]
script = ExtResource("2_dline")
character_id = "shark"
position = "right"
text_zh = "先拿走。然後我們查清楚 Owen 為什麼要包圍這裡。"
text_en = "Take them. Then we find out why Owen wanted this place surrounded."

[sub_resource type="Resource" id="post_panda"]
script = ExtResource("2_dline")
character_id = "panda"
text_zh = "正式冒險者遇上第一場正式災難。聽起來很合理。"
text_en = "Official adventurers on our first official disaster. That sounds about right."

[sub_resource type="Resource" id="post_dialog"]
script = ExtResource("3_dseq")
lines = Array[ExtResource("2_dline")]([SubResource("post_clear"), SubResource("post_duan"), SubResource("post_dragon"), SubResource("post_shark"), SubResource("post_panda")])
cast = Array[String](["dragon", "panda", "duan", "shark"])
background = ExtResource("8_church_bg")
initial_music = ExtResource("9_music")

[sub_resource type="Resource" id="pre_arrive"]
script = ExtResource("2_dline")
text_zh = "隊伍抵達聖所，這裡是新晉冒險者領取正式證書的地方。"
text_en = "The team reaches the sanctuary where new adventurers receive their official certificates."
music = ExtResource("9_music")

[sub_resource type="Resource" id="pre_dragon"]
script = ExtResource("2_dline")
character_id = "dragon"
text_zh = "就是那裡！拿到證書之後，我們就是合法無敵了。"
text_en = "There it is! One certificate, then we are legally unstoppable."
action = "enter"

[sub_resource type="Resource" id="pre_panda"]
script = ExtResource("2_dline")
character_id = "panda"
text_zh = "拜託不要在聖所旁邊說什麼合法無敵。"
text_en = "Please never say legally unstoppable near a holy building."
action = "enter"

[sub_resource type="Resource" id="pre_duan"]
script = ExtResource("2_dline")
character_id = "duan"
position = "right"
text_zh = "情況不對。大門開著，但沒有人守著封印。"
text_en = "Something is wrong. The doors are open, but no one is guarding the seal."
action = "enter"

[sub_resource type="Resource" id="pre_shark"]
script = ExtResource("2_dline")
character_id = "shark"
position = "right"
text_zh = "有腳步聲。不只一個。"
text_en = "Footsteps. More than one."
action = "enter"

[sub_resource type="Resource" id="pre_minion"]
script = ExtResource("2_dline")
text_zh = "Owen 的爪牙從聖所走廊湧出，包圍了證書祭壇。"
text_en = "Owen's minions pour from the sanctuary halls, surrounding the certificate altar."

[sub_resource type="Resource" id="pre_panda_2"]
script = ExtResource("2_dline")
character_id = "panda"
text_zh = "看來這趟差事一點也不簡單。"
text_en = "So much for a simple errand."

[sub_resource type="Resource" id="pre_dialog"]
script = ExtResource("3_dseq")
lines = Array[ExtResource("2_dline")]([SubResource("pre_arrive"), SubResource("pre_dragon"), SubResource("pre_panda"), SubResource("pre_duan"), SubResource("pre_shark"), SubResource("pre_minion"), SubResource("pre_panda_2")])
cast = Array[String](["dragon", "panda", "duan", "shark"])
background = ExtResource("8_church_bg")
initial_music = ExtResource("9_music")

