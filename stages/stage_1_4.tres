[sub_resource type="Resource" id="stage13_pre_2"]
script = ExtResource("3_dline")
character_id = "owen"
position = "right"
text_zh = "終於找到你了... 光之水晶"

[sub_resource type="Resource" id="Resource_vwwgi"]
script = ExtResource("3_dline")
character_id = "owen"
position = "right"
text_zh = "這個世界太過腐敗。唯有混亂與重生。"

[sub_resource type="Resource" id="Resource_57o8d"]
