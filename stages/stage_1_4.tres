[sub_resource type="Resource" id="Resource_8idvt"]
script = ExtResource("3_dline")
text_zh = "在光之皇座上, 一顆散發著燦爛幽光的藍色寶石靜靜地佇立著。"

[sub_resource type="Resource" id="Resource_3pugy"]
script = ExtResource("3_dline")
text_zh = "奧云伸手將光之水晶一把拔出，無數的光元素從座台中噴湧而出。"

[sub_resource type="Resource" id="Resource_enq8n"]
script = ExtResource("3_dline")
text_zh = "讓黑暗漫延吧。讓世界重啟吧。"

[sub_resource type="Resource" id="Resource_w6yip"]
script = ExtResource("3_dline")
action = "switch_bg"
shake = false
background = ExtResource("2_vwwgi")

[sub_resource type="Resource" id="Resource_kqu2e"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "奧云！住手!! 你在幹嘛！？"

[sub_resource type="Resource" id="Resource_ssn5h"]
script = ExtResource("3_dline")
character_id = "owen"
position = "right"
text_zh = "喔？是你啊。光之忠犬。"

[sub_resource type="Resource" id="Resource_ihorc"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "你手上拿著的是... 光之水晶!?"

[sub_resource type="Resource" id="Resource_cwsa5"]
script = ExtResource("3_dline")
character_id = "owen"
position = "right"
text_zh = "沒錯。很快，這個世界將不覆有光。"

