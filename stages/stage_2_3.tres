[sub_resource type="Resource" id="s23_pre_gory_ouch"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "呃啊啊!!!"
action = "enter"

[sub_resource type="Resource" id="s23_pre_panda_shock"]
script = ExtResource("3_line")
character_id = "panda"
position = "right"
text_zh = "!!!"
action = "enter"

[sub_resource type="Resource" id="s23_pre_dragon_sorry"]
script = ExtResource("3_line")
character_id = "dragon"
position = "right"
text_zh = "抱歉我看你攻過來就自然反擊, 你沒受傷吧?"
action = "enter"

[sub_resource type="Resource" id="s23_pre_shark_zanshin"]
script = ExtResource("3_line")
character_id = "shark"
text_zh = "殘心! 不要鬆懈!"
action = "enter"

[sub_resource type="Resource" id="s23_pre_gory_lost"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "是在下輸了"

[sub_resource type="Resource" id="s23_pre_gory_dispose"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "要怎麼處置在下, 任由你們決定"

[sub_resource type="Resource" id="s23_pre_panda_not_killers"]
script = ExtResource("3_line")
character_id = "panda"
position = "right"
text_zh = "不是的! 我們不是什麼殺人魔!! 不過, 請教你的事情倒是有一件"

[sub_resource type="Resource" id="s23_pre_dragon_forest"]
script = ExtResource("3_line")
character_id = "dragon"
position = "right"
text_zh = "我們要去森之國"

[sub_resource type="Resource" id="s23_pre_shark_crystal"]
script = ExtResource("3_line")
character_id = "shark"
text_zh = "我們需要找到光之水晶並保護它, 光之國的水晶已經陷落了"

[sub_resource type="Resource" id="s23_pre_gory_elder"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "我知道了, 我帶你們去找我們的長老吧"

[sub_resource type="Resource" id="s23_pre"]
script = ExtResource("4_seq")
lines = Array[ExtResource("3_line")]([SubResource("s23_pre_gory_ouch"), SubResource("s23_pre_panda_shock"), SubResource("s23_pre_dragon_sorry"), SubResource("s23_pre_shark_zanshin"), SubResource("s23_pre_gory_lost"), SubResource("s23_pre_gory_dispose"), SubResource("s23_pre_panda_not_killers"), SubResource("s23_pre_dragon_forest"), SubResource("s23_pre_shark_crystal"), SubResource("s23_pre_gory_elder")])
cast = Array[String](["gory", "panda", "dragon", "shark"])

[sub_resource type="Resource" id="s23_start_1"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "前面是村道。大家都很怕外人，別亂衝。"
text_en = "The village road is ahead. Everyone fears outsiders, so do not rush in."

[sub_resource type="Resource" id="s23_start_2"]
script = ExtResource("3_line")
character_id = "dragon"
position = "right"
text_zh = "如果有人擋住路，我會先問清楚。大概。"
text_en = "If someone blocks us, I will ask first. Probably."

[sub_resource type="Resource" id="s23_start"]
script = ExtResource("4_seq")
lines = Array[ExtResource("3_line")]([SubResource("s23_start_1"), SubResource("s23_start_2")])
cast = Array[String](["gory", "dragon"])

[sub_resource type="Resource" id="s23_post_dragon_tired"]
script = ExtResource("3_line")
character_id = "dragon"
text_zh = "到了嘛，已經沒力了。"

[sub_resource type="Resource" id="s23_post_panda_hungry"]
script = ExtResource("3_line")
character_id = "panda"
position = "right"
text_zh = "我要餓死了。"

[sub_resource type="Resource" id="s23_post_gory_light"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "看到前方的亮光了嗎? 那裡就是森之國了。"

[sub_resource type="Resource" id="s23_post_bg_street"]
script = ExtResource("3_line")
action = "switch_bg"
background = ExtResource("9_bg")

[sub_resource type="Resource" id="s23_post_gate"]
script = ExtResource("3_line")
text_zh = "走過一道石門，一行人終於抵達了森之國。"

[sub_resource type="Resource" id="s23_post_city"]
script = ExtResource("3_line")
text_zh = "森之國四處綠草如恩，房子由木和石磚建成。縱然沒有什麼宏偉的建築，卻有一種悠遊恬靜的感覺，不過城內的村民卻穿著殘舊的破布，愁眉苦臉。"

[sub_resource type="Resource" id="s23_post_villager_beg"]
script = ExtResource("3_line")
character_id = "villager"
text_zh = "行行好吧! 我已經4天沒吃飯了"

[sub_resource type="Resource" id="s23_post_bg_transmute"]
script = ExtResource("3_line")
action = "switch_bg"
background = ExtResource("10_transmute")

[sub_resource type="Resource" id="s23_post_amon_pray"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "光之神啊，請賜我力量賦予人民人物吧。"
action = "enter"

[sub_resource type="Resource" id="s23_post_amon_fruit"]
script = ExtResource("3_line")
text_zh = "[啊蒙走到村民面前, 用手觸碰頭頂的光之寶石, 一陣閃耀的轉化之光閃過, 啊蒙手中生成了一個香甜美味的綠色水果。]"

[sub_resource type="Resource" id="s23_post_bg_back_street"]
script = ExtResource("3_line")
action = "switch_bg"
background = ExtResource("9_bg")

[sub_resource type="Resource" id="s23_post_amon_bless"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "願光之神與你同在"

[sub_resource type="Resource" id="s23_post_villager_thanks"]
script = ExtResource("3_line")
character_id = "villager"
text_zh = "謝謝啊蒙, 謝謝光之神!"

[sub_resource type="Resource" id="s23_post_villagers_thanks"]
script = ExtResource("3_line")
character_id = "villagers"
text_zh = "謝謝啊蒙, 謝謝光之神!"

[sub_resource type="Resource" id="s23_post_amon_gory"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "啊, 這不是戈爾嗎?"

[sub_resource type="Resource" id="s23_post_gory_elder"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "長老好。這三位旅行者從光之國過來，說有要事要找你。"

[sub_resource type="Resource" id="s23_post_dragon_intro"]
script = ExtResource("3_line")
character_id = "dragon"
text_zh = "你好! 我叫米洛!"

[sub_resource type="Resource" id="s23_post_panda_intro"]
script = ExtResource("3_line")
character_id = "panda"
text_zh = "我是阿潘!"

[sub_resource type="Resource" id="s23_post_shark_intro"]
script = ExtResource("3_line")
character_id = "shark"
text_zh = "......埃德。"

[sub_resource type="Resource" id="s23_post_amon_guests"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "原來是光之國的貴客啊。"

[sub_resource type="Resource" id="s23_post_amon_welcome"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "歡迎來到森之國，我的朋友，我是森之國的長老，啊蒙。"

[sub_resource type="Resource" id="s23_post_amon_meal"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "周居勞頓，大家都累了吧，來，先吃飯吧。"

[sub_resource type="Resource" id="s23_post_bg_hall"]
script = ExtResource("3_line")
action = "switch_bg"
background = ExtResource("11_hall")

[sub_resource type="Resource" id="s23_post_evening"]
script = ExtResource("3_line")
text_zh = "天色漸暗，米洛一行人被邀請到城鎖中心大堂吃飯。"

[sub_resource type="Resource" id="s23_post_foods"]
script = ExtResource("3_line")
text_zh = "燒雞，麵包，水果，牛奶，蜂蜜。"

[sub_resource type="Resource" id="s23_post_hungry_party"]
script = ExtResource("3_line")
text_zh = "米洛一行人早就餓壞了。"

[sub_resource type="Resource" id="s23_post_panda_senbei"]
script = ExtResource("3_line")
character_id = "panda"
text_zh = "哇! 是竹葉仙貝!"

[sub_resource type="Resource" id="s23_post_dragon_chicken"]
script = ExtResource("3_line")
character_id = "dragon"
text_zh = "是雞腿!"

[sub_resource type="Resource" id="s23_post_shark_careful"]
script = ExtResource("3_line")
character_id = "shark"
text_zh = "小心!! 我們還不知道..."

[sub_resource type="Resource" id="s23_post_dragon_trust"]
script = ExtResource("3_line")
character_id = "dragon"
text_zh = "放心啦，一國之君怎麼會對我們下手"

[sub_resource type="Resource" id="s23_post_gory_food"]
script = ExtResource("3_line")
character_id = "gory"
position = "right"
text_zh = "長老，這些食物..."

[sub_resource type="Resource" id="s23_post_amon_later"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "好了戈爾，拿出森之國的待客之道，有什麼之後再說吧。"

[sub_resource type="Resource" id="s23_post_gory_silent"]
script = ExtResource("3_line")
character_id = "gory"
position = "right"
text_zh = "..."

[sub_resource type="Resource" id="s23_post_panda_remember"]
script = ExtResource("3_line")
character_id = "panda"
text_zh = "啊姆啊姆啊姆... 對了，那件事！！"

[sub_resource type="Resource" id="s23_post_dragon_owen"]
script = ExtResource("3_line")
character_id = "dragon"
text_zh = "對了，奧雲！"

[sub_resource type="Resource" id="s23_post_dragon_crystal"]
script = ExtResource("3_line")
character_id = "dragon"
text_zh = "我們來是要保護光之水晶! 奧云在光之國偷走了光之水晶!"

[sub_resource type="Resource" id="s23_post_amon_smile"]
script = ExtResource("3_line")
text_zh = "啊蒙與衛兵們相視而笑"

[sub_resource type="Resource" id="s23_post_amon_safe"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "放心， 光之水晶很安全"

[sub_resource type="Resource" id="s23_post_amon_system"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "木之國的經濟、防禦系統，都仰賴光之水晶。"

[sub_resource type="Resource" id="s23_post_amon_interest"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "如果光之水晶有什麼不測，我們肯定是第一個身受其害的。"

[sub_resource type="Resource" id="s23_post_shark_fallen"]
script = ExtResource("3_line")
character_id = "shark"
text_zh = "光之國淪陷了! 裡面全是奧雲的士兵。"

[sub_resource type="Resource" id="s23_post_amon_confident"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "喔，我跟老國王認識很久了，光之國的防禦，我很有信心。"

[sub_resource type="Resource" id="s23_post_dragon_husky"]
script = ExtResource("3_line")
character_id = "dragon"
text_zh = "我親眼看見 Husky 和國王被抓捕扣押的! 我們需要對抗奧雲！"

[sub_resource type="Resource" id="s23_post_amon_darkens"]
script = ExtResource("3_line")
text_zh = "[M面色一沉]"

[sub_resource type="Resource" id="s23_post_amon_understand"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "我知道了。"

[sub_resource type="Resource" id="s23_post_amon_leave"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "時候不早了, 你們先回吧。"

[sub_resource type="Resource" id="s23_post_shark_tch"]
script = ExtResource("3_line")
character_id = "shark"
text_zh = "切"

[sub_resource type="Resource" id="s23_post_bg_after"]
script = ExtResource("3_line")
action = "switch_bg"
background = ExtResource("9_bg")

[sub_resource type="Resource" id="s23_post_panda_hard"]
script = ExtResource("3_line")
character_id = "panda"
text_zh = "看來沒那麼容易呢"

[sub_resource type="Resource" id="s23_post_shark_not_care"]
script = ExtResource("3_line")
character_id = "shark"
text_zh = "我看他根本沒當回事"

[sub_resource type="Resource" id="s23_post_dragon_ambush"]
script = ExtResource("3_line")
character_id = "dragon"
text_zh = "只能暫時停留在這裡一會兒嘍，就當作是埋伏奧雲大作戰！"

[sub_resource type="Resource" id="s23_post_panda_accept"]
script = ExtResource("3_line")
character_id = "panda"
text_zh = "也只能這樣了。"

[sub_resource type="Resource" id="s23_post_shark_sigh"]
script = ExtResource("3_line")
character_id = "shark"
text_zh = "哎。"

