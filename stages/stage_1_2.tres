[sub_resource type="Resource" id="post_duan_1"]
script = ExtResource("3_dline")
character_id = "duan"
position = "right"
text_zh = "我輸了……但我明白 Husky 老師為什麼信任你們。"
text_en = "I lost... but I understand why Master Husky trusts you."
action = "enter"
music = ExtResource("8_music")

[sub_resource type="Resource" id="post_husky"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "很好。決鬥比講課更能教會你們節奏。"
text_en = "Good. A duel teaches rhythm better than a lecture."
action = "enter"

[sub_resource type="Resource" id="post_dragon"]
script = ExtResource("3_dline")
character_id = "dragon"
text_zh = "Duan，跟我們一起來吧！接下來我們要去拿冒險者證書。"
text_en = "Duan, come with us! We are getting our adventurer certificate next."

[sub_resource type="Resource" id="post_duan_2"]
script = ExtResource("3_dline")
character_id = "duan"
position = "right"
text_zh = "如果老師允許，我想在實戰中學習。"
text_en = "If Master permits it, I would like to learn in the field."

[sub_resource type="Resource" id="post_husky_2"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "准許。你們所有人都要保持警覺。"
text_en = "Permission granted. Stay sharp, all of you."

[sub_resource type="Resource" id="post_dialog"]
script = ExtResource("4_dseq")
lines = Array[ExtResource("3_dline")]([SubResource("post_duan_1"), SubResource("post_husky"), SubResource("post_dragon"), SubResource("post_duan_2"), SubResource("post_husky_2")])
cast = Array[String](["husky", "duan", "dragon"])
background = ExtResource("7_classroom_bg")
initial_music = ExtResource("8_music")

[sub_resource type="Resource" id="pre_intro"]
script = ExtResource("3_dline")
text_zh = "畢業演練結束後，Husky 要隊伍留在訓練廳。"
text_en = "After graduation drills, Husky asks the team to stay in the training hall."
music = ExtResource("8_music")

[sub_resource type="Resource" id="pre_husky_1"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "在你們去拿證書之前，還有最後一課：和另一名寶石使用者交手。"
text_en = "Before you go chasing certificates, there is one more lesson: fighting another gem user."
action = "enter"

[sub_resource type="Resource" id="pre_duan_enter"]
script = ExtResource("3_dline")
character_id = "duan"
position = "right"
text_zh = "Husky 老師，我準備好了。"
text_en = "Master Husky, I am ready."
action = "enter"

[sub_resource type="Resource" id="pre_husky_2"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "這位是 Duan，我最年輕的學生。他讀盤很快，也擅長用光寶石保護自己。"
text_en = "This is Duan, my youngest student. He reads the board quickly and protects himself with light gems."

[sub_resource type="Resource" id="pre_panda"]
script = ExtResource("3_dline")
character_id = "panda"
text_zh = "最年輕的學生？他看起來比我們全部人都嚴肅。"
text_en = "Youngest student? He looks more serious than all of us."

[sub_resource type="Resource" id="pre_duan_challenge"]
script = ExtResource("3_dline")
character_id = "duan"
position = "right"
text_zh = "請和我決鬥。我會像敵方冒險者一樣行動，也不會手下留情。"
text_en = "Please duel me. I will move as an enemy adventurer would, and I will not hold back."

[sub_resource type="Resource" id="pre_husky_3"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "仔細看好。決鬥時，敵人也能使用棋盤。"
text_en = "Watch carefully. In a duel, the enemy can use the board too."

[sub_resource type="Resource" id="pre_dialog"]
script = ExtResource("4_dseq")
lines = Array[ExtResource("3_dline")]([SubResource("pre_intro"), SubResource("pre_husky_1"), SubResource("pre_duan_enter"), SubResource("pre_husky_2"), SubResource("pre_panda"), SubResource("pre_duan_challenge"), SubResource("pre_husky_3")])
cast = Array[String](["husky", "duan", "panda"])
background = ExtResource("7_classroom_bg")
initial_music = ExtResource("8_music")

