[sub_resource type="Resource" id="post_duan_1"]
script = ExtResource("3_dline")
character_id = "duan"
position = "right"
text_zh = "我輸了…米洛你們真的很強。我還需要更多的練習。"
text_en = "I lost... but I understand why Master Husky trusts you."
action = "enter"

[sub_resource type="Resource" id="post_dragon"]
script = ExtResource("3_dline")
character_id = "dragon"
text_zh = "你也很強啊敦！和你戰鬥真有趣！"
text_en = "Duan, come with us! We are getting our adventurer certificate next."

[sub_resource type="Resource" id="Resource_2sd5u"]
script = ExtResource("3_dline")
character_id = "duan"
position = "right"
text_zh = "謝謝你米洛。我不會再打擾你們上課了。"
text_en = "I lost... but I understand why Master Husky trusts you."
action = "enter"

[sub_resource type="Resource" id="Resource_l23w1"]
script = ExtResource("3_dline")
character_id = "duan"
position = "right"
action = "exit"
shake = false

[sub_resource type="Resource" id="post_husky"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "啊..."
text_en = "Good. A duel teaches rhythm better than a lecture."
action = "enter"

[sub_resource type="Resource" id="Resource_6rsta"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "這樣吧，敦，雖然你還未夠資格成為冒險者，但我準備你一同參加這次的冒險者加冕儀式。"
text_en = "Good. A duel teaches rhythm better than a lecture."
action = "enter"

[sub_resource type="Resource" id="post_duan_2"]
script = ExtResource("3_dline")
character_id = "duan"
position = "right"
text_zh = "真的嗎！老師！"
text_en = "If Master permits it, I would like to learn in the field."
action = "enter"

[sub_resource type="Resource" id="Resource_crnws"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "嗯。跟著團隊實戰對你也是一件好事。"
text_en = "Good. A duel teaches rhythm better than a lecture."
action = "enter"

[sub_resource type="Resource" id="post_husky_2"]
script = ExtResource("3_dline")
character_id = "panda"
text_zh = "太好了！敦！"
text_en = "Permission granted. Stay sharp, all of you."

[sub_resource type="Resource" id="Resource_wery2"]
script = ExtResource("3_dline")
character_id = "dragon"
text_zh = "耶！"
text_en = "Duan, come with us! We are getting our adventurer certificate next."

[sub_resource type="Resource" id="Resource_4elfx"]
