[sub_resource type="Resource" id="pre_intro"]
script = ExtResource("3_dline")
text_zh = "畢業演練結束後，一個學生從門口衝了進來。"
text_en = "After graduation drills, Husky asks the team to stay in the training hall."

[sub_resource type="Resource" id="pre_duan_enter"]
script = ExtResource("3_dline")
character_id = "duan"
position = "right"
text_zh = "看招~啊啊啊！！！"
text_en = "Master Husky, I am ready."
action = "enter"

[sub_resource type="Resource" id="pre_panda"]
script = ExtResource("3_dline")
character_id = "panda"
text_zh = "危險！"
text_en = "Youngest student? He looks more serious than all of us."

[sub_resource type="Resource" id="pre_husky_1"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "敦，我說過，你離成為冒險者還有不少的訓練。"
text_en = "Before you go chasing certificates, there is one more lesson: fighting another gem user."
action = "enter"

[sub_resource type="Resource" id="pre_duan_challenge"]
script = ExtResource("3_dline")
character_id = "duan"
position = "right"
text_zh = "我不管！你說過打贏米洛他們，我就有資格一起冒險！"
text_en = "Please duel me. I will move as an enemy adventurer would, and I will not hold back."

[sub_resource type="Resource" id="pre_husky_2"]
script = ExtResource("3_dline")
character_id = "husky"
text_zh = "哎呀..."
text_en = "This is Duan, my youngest student. He reads the board quickly and protects himself with light gems."

[sub_resource type="Resource" id="pre_husky_3"]
script = ExtResource("3_dline")
character_id = "dragon"
text_zh = "我接受你的挑戰！"
text_en = "Watch carefully. In a duel, the enemy can use the board too."

