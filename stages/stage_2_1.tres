character_id = "dragon"
text_zh = "這片森林的光元素太重了，連空氣都像在發燙。"
text_en = "The light energy here is overloaded. Even the air feels hot."

[sub_resource type="Resource" id="s21_start_2"]
script = ExtResource("3_line")
character_id = "shark"
position = "right"
text_zh = "保持隊形。葉元素很少，別把恢復手段浪費掉。"
text_en = "Hold formation. Leaf energy is scarce here, so do not waste recovery."

