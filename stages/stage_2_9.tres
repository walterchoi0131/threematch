[sub_resource type="Resource" id="s29_post_1"]
script = ExtResource("3_line")
character_id = "giz"
text_zh = "謝謝你們……我還可以幫忙，把過剩的光變回森林需要的力量。"
text_en = "Thank you... I can help turn the excess light back into what the forest needs."

[sub_resource type="Resource" id="s29_post_2"]
script = ExtResource("3_line")
character_id = "panda"
position = "right"
text_zh = "歡迎加入，Giz。先吃點東西，再拯救世界。順序很重要。"
text_en = "Welcome, Giz. Eat first, save the world second. Order matters."

[sub_resource type="Resource" id="s29_post"]
script = ExtResource("4_seq")
lines = Array[ExtResource("3_line")]([SubResource("s29_post_1"), SubResource("s29_post_2")])
cast = Array[String](["giz", "panda"])

[sub_resource type="Resource" id="s29_pre_1"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "Giz 就在祭壇上！先解開機關，不要傷到他！"
text_en = "Giz is on the altar! Break the mechanism first, do not hurt him!"

[sub_resource type="Resource" id="s29_pre_2"]
script = ExtResource("3_line")
character_id = "shark"
position = "right"
text_zh = "目標是鑰匙。用爆破打開束縛，控制連鎖範圍。"
text_en = "The keys are the objective. Use blasts to release the bindings and control the chain."

[sub_resource type="Resource" id="s29_pre"]
script = ExtResource("4_seq")
lines = Array[ExtResource("3_line")]([SubResource("s29_pre_1"), SubResource("s29_pre_2")])
cast = Array[String](["gory", "shark", "giz"])

