[sub_resource type="Resource" id="Resource_oogjj"]
script = ExtResource("3_oa5gx")
text_zh = "走過一道石門，一行人終於抵達了森之國。"

[sub_resource type="Resource" id="Resource_1of18"]
script = ExtResource("3_oa5gx")
text_zh = "森之國四處綠草如恩，房子由木和石磚建成。縱然沒有什麼宏偉的建築，卻有一種悠遊恬靜的感覺，不過城內的村民卻穿著殘舊的破布，愁眉苦臉。"

[sub_resource type="Resource" id="Resource_w7a1h"]
