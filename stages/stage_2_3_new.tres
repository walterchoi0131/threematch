[sub_resource type="Resource" id="Resource_vd5pa"]
script = ExtResource("7_3fvqq")

[sub_resource type="Resource" id="Resource_r8n6p"]
script = ExtResource("3_oa5gx")
text_zh = "天色漸暗，米洛一行人被邀請到城鎖中心大堂吃飯。"

[sub_resource type="Resource" id="Resource_fchjq"]
script = ExtResource("3_oa5gx")
text_zh = "燒雞，麵包，水果，牛奶，蜂蜜。"

[sub_resource type="Resource" id="Resource_jgim4"]
script = ExtResource("3_oa5gx")
text_zh = "米洛一行人早就餓壞了。"

[sub_resource type="Resource" id="Resource_t2xtl"]
script = ExtResource("3_oa5gx")
character_id = "panda"
text_zh = "哇! 是竹葉仙貝!"
action = "enter"

[sub_resource type="Resource" id="Resource_ygomd"]
script = ExtResource("3_oa5gx")
character_id = "dragon"
text_zh = "是雞腿!"
action = "enter"

[sub_resource type="Resource" id="Resource_6my4h"]
script = ExtResource("3_oa5gx")
character_id = "shark"
position = "right"
text_zh = "小心!! 我們還不知道..."
action = "enter"

[sub_resource type="Resource" id="Resource_yeh2l"]
script = ExtResource("3_oa5gx")
character_id = "dragon"
text_zh = "放心啦，一國之君怎麼會對我們下手"
action = "enter"

[sub_resource type="Resource" id="Resource_j4leu"]
script = ExtResource("3_oa5gx")
character_id = "gory"
text_zh = "長老，這些食物..."
action = "enter"

[sub_resource type="Resource" id="Resource_smiko"]
script = ExtResource("3_oa5gx")
character_id = "amon"
position = "right"
text_zh = "好了戈爾，拿出森之國的待客之道，有什麼之後再說吧。"
action = "enter"

[sub_resource type="Resource" id="Resource_3pll8"]
script = ExtResource("3_oa5gx")
character_id = "gory"
text_zh = "..."
action = "enter"

[sub_resource type="Resource" id="Resource_7wjh3"]
script = ExtResource("3_oa5gx")
character_id = "panda"
text_zh = "啊姆啊姆啊姆... 對了，那件事！！"
action = "enter"

[sub_resource type="Resource" id="Resource_kq75k"]
script = ExtResource("3_oa5gx")
character_id = "dragon"
text_zh = "對了，奧雲！"
action = "enter"

[sub_resource type="Resource" id="Resource_ugmgn"]
script = ExtResource("3_oa5gx")
character_id = "dragon"
text_zh = "我們來是要保護光之水晶! 奧云在光之國偷走了光之水晶!"
action = "enter"

[sub_resource type="Resource" id="Resource_qtt2a"]
script = ExtResource("3_oa5gx")
text_zh = "啊蒙與衛兵們相視而笑"

[sub_resource type="Resource" id="Resource_yndsc"]
script = ExtResource("3_oa5gx")
character_id = "amon"
position = "right"
text_zh = "放心， 光之水晶很安全"
action = "enter"

[sub_resource type="Resource" id="Resource_n3ivx"]
script = ExtResource("3_oa5gx")
character_id = "amon"
position = "right"
text_zh = "木之國的經濟、防禦系統，都仰賴光之水晶。"
action = "enter"

[sub_resource type="Resource" id="Resource_dfaev"]
script = ExtResource("3_oa5gx")
character_id = "amon"
position = "right"
text_zh = "如果光之水晶有什麼不測，我們肯定是第一個身受其害的。"
action = "enter"

[sub_resource type="Resource" id="Resource_yx200"]
script = ExtResource("3_oa5gx")
character_id = "shark"
text_zh = "光之國淪陷了! 裡面全是奧雲的士兵。"
action = "enter"

[sub_resource type="Resource" id="Resource_7qalj"]
script = ExtResource("3_oa5gx")
character_id = "amon"
position = "right"
text_zh = "喔，我跟老國王認識很久了，光之國的防禦，我很有信心。"
action = "enter"

[sub_resource type="Resource" id="Resource_sxcen"]
script = ExtResource("3_oa5gx")
character_id = "dragon"
text_zh = "我親眼看見 Husky 和國王被抓捕扣押的! 我們需要對抗奧雲！"
action = "enter"

[sub_resource type="Resource" id="Resource_rk14x"]
script = ExtResource("3_oa5gx")
text_zh = "啊蒙面色一沉"
action = "enter"

[sub_resource type="Resource" id="Resource_dvpjg"]
script = ExtResource("3_oa5gx")
character_id = "amon"
position = "right"
text_zh = "我知道了。"
