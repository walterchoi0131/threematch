[sub_resource type="Resource" id="Resource_stage1_intro_morning"]
script = ExtResource("3_6yv1j")
text_zh = "清晨的陽光溜進宿舍臥室。阿潘還整隻埋在棉被裡。"
text_en = "Morning light slips into the dorm bedroom. Pan is still buried under his blanket."
music = ExtResource("4_tq0q5")

[sub_resource type="Resource" id="Resource_stage1_intro_dragon_wakeup"]
script = ExtResource("3_6yv1j")
character_id = "dragon"
emotion = "excited"
position = "right"
text_zh = "阿潘！阿潘！起床啦！今天可是大日子！超大的日子！"
text_en = "Pan! Pan! Wake up! This is a big day! The BIG day!"
action = "enter"

[sub_resource type="Resource" id="Resource_stage1_intro_panda_waking"]
script = ExtResource("3_6yv1j")
character_id = "panda"
emotion = "sleepy"
text_zh = "Zzz... zz... 米洛？現在幾點啊……"
text_en = "Zzz... zz... Milo? What time is it now?..."
action = "enter"

[sub_resource type="Resource" id="Resource_stage1_intro_dragon_graduate"]
script = ExtResource("3_6yv1j")
character_id = "dragon"
emotion = "excited"
position = "right"
text_zh = "我們今天要從冒險者學校畢業了！畢業生！真正的冒險者！說不定還會有披風！"
text_en = "We graduate from adventurer's school today! Graduates! Real adventurers! With capes maybe!"

[sub_resource type="Resource" id="Resource_stage1_intro_panda_sleepy"]
script = ExtResource("3_6yv1j")
character_id = "panda"
emotion = "sleepy"
text_zh = "米洛，安靜一點……Zzz……你要是吵醒埃德，他會在早餐前把我們捏扁。"
text_en = "Milo, be quiet... Zzz... If you wake Ed up, he'll crush us before breakfast."

[sub_resource type="Resource" id="Resource_stage1_intro_dragon_shark_up"]
script = ExtResource("3_6yv1j")
character_id = "dragon"
emotion = "happy"
position = "right"
text_zh = "喔，埃德早就醒了。"
text_en = "Oh, Ed is already up."

[sub_resource type="Resource" id="Resource_stage1_intro_pullup_narration"]
script = ExtResource("3_6yv1j")
text_zh = "埃德掛在門框上，冷靜地做著引體向上，彷彿這只是再普通不過的早晨。"
text_en = "Ed hangs from the door frame, calmly doing pull-ups like this is a normal morning."

[sub_resource type="Resource" id="Resource_stage1_intro_shark_pullup"]
script = ExtResource("3_6yv1j")
character_id = "shark"
text_zh = "早，阿潘。四十七……四十八……"
text_en = "Morning, Pan. Forty-seven... forty-eight..."
action = "enter"

[sub_resource type="Resource" id="Resource_stage1_intro_panda_ed_too"]
script = ExtResource("3_6yv1j")
character_id = "panda"
emotion = "sleepy"
text_zh = "啊...?! 埃德你也?!"
text_en = "Ah...?! Ed, you too?!"

[sub_resource type="Resource" id="Resource_stage1_intro_shark_morning"]
script = ExtResource("3_6yv1j")
character_id = "shark"
text_zh = "一日之計在於晨，阿潘，你也該好好利用早晨的時間。"
text_en = "Morning, Pan. Make good use of the morning too."
action = "enter"

[sub_resource type="Resource" id="Resource_stage1_intro_panda_outvoted"]
script = ExtResource("3_6yv1j")
character_id = "panda"
emotion = "sleepy"
text_zh = "好吧，二對一。"
text_en = "Alright, two against one."

[sub_resource type="Resource" id="Resource_stage1_intro_dragon_go"]
script = ExtResource("3_6yv1j")
character_id = "dragon"
emotion = "excited"
position = "right"
text_zh = "好耶！！我們快走吧！"
text_en = "Yay!! Let's go!"

[sub_resource type="Resource" id="Resource_stage1_intro_panda_breakfast"]
script = ExtResource("3_6yv1j")
character_id = "panda"
emotion = "sleepy"
text_zh = "慢一點，我還沒吃早餐..."
text_en = "Slow down, I haven't had breakfast..."

[sub_resource type="Resource" id="Resource_fsca4"]
script = ExtResource("3_6yv1j")
character_id = "panda"
action = "exit"
shake = false

