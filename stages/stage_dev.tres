[sub_resource type="Resource" id="Resource_o6cdy"]
script = ExtResource("3_6yv1j")
character_id = "husky"
text_zh = "早上好!"

[sub_resource type="Resource" id="Resource_7x61u"]
script = ExtResource("3_6yv1j")
character_id = "husky"
text_zh = "今天是我們班初級冒險終末考試! 會進行實戰演練考驗大家的身手!"

[sub_resource type="Resource" id="Resource_epvkr"]
script = ExtResource("3_6yv1j")
character_id = "husky"
text_zh = "基礎的戰鬥方式大家都有好好練習嗎?"

[sub_resource type="Resource" id="Resource_wrajf"]
script = ExtResource("3_6yv1j")
character_id = "dragon"
position = "right"
text_zh = "有的老師, 有的!!"

[sub_resource type="Resource" id="Resource_smhwd"]
script = ExtResource("3_6yv1j")
character_id = "shark"
position = "right"
text_zh = "當是當然。"

[sub_resource type="Resource" id="Resource_jg7yr"]
script = ExtResource("3_6yv1j")
character_id = "panda"
position = "right"
text_zh = "哎呀呀..."

[sub_resource type="Resource" id="Resource_lyr6i"]
