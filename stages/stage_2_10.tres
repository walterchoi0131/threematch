[sub_resource type="Resource" id="s210_post_1"]
script = ExtResource("3_line")
character_id = "owen"
position = "right"
text_zh = "辛苦了。你們替我把路清得很乾淨。光之水晶，我收下了。"
text_en = "Well done. You cleared the path for me. I will take the Light Crystal."

[sub_resource type="Resource" id="s210_post_2"]
script = ExtResource("3_line")
character_id = "amon"
text_zh = "看看你們做了什麼！沒有水晶，村子現在怎麼辦？"
text_en = "Look what you have done! Without the crystal, what happens to the village now?"

[sub_resource type="Resource" id="s210_post_3"]
script = ExtResource("3_line")
character_id = "dragon"
text_zh = "我……不知道。但我一定會把 Owen 追回來。"
text_en = "I... do not know. But I will chase Owen down."

[sub_resource type="Resource" id="s210_post"]
script = ExtResource("4_seq")
lines = Array[ExtResource("3_line")]([SubResource("s210_post_1"), SubResource("s210_post_2"), SubResource("s210_post_3")])
cast = Array[String](["owen", "amon", "dragon", "panda", "shark", "gory", "giz"])
cast_profiles = {
"amon": {
"enemy_path": "res://enemies/amon.tres",
"kind": "enemy",
"name_en": "Amon",
"name_zh": "阿蒙"
}
}

[sub_resource type="Resource" id="s210_pre_1"]
script = ExtResource("3_line")
character_id = "amon"
position = "right"
text_zh = "你們破壞了祭典，還妄想拯救森林？"
text_en = "You ruined the ritual and still think you can save the forest?"

[sub_resource type="Resource" id="s210_pre_2"]
script = ExtResource("3_line")
character_id = "dragon"
text_zh = "用孩子祭天的人，沒資格說拯救。"
text_en = "Someone who sacrifices children has no right to speak of salvation."

[sub_resource type="Resource" id="s210_pre"]
script = ExtResource("4_seq")
lines = Array[ExtResource("3_line")]([SubResource("s210_pre_1"), SubResource("s210_pre_2")])
cast = Array[String](["amon", "dragon"])
cast_profiles = {
"amon": {
"enemy_path": "res://enemies/amon.tres",
"kind": "enemy",
"name_en": "Amon",
"name_zh": "阿蒙"
}
}

