[sub_resource type="Resource" id="s24_post_guard_groan"]
script = ExtResource("10_line")
character_id = "guard"
position = "right"
text_zh = "呃... 啊!!!"

[sub_resource type="Resource" id="s24_post_guard_threat"]
script = ExtResource("10_line")
character_id = "guard"
position = "right"
text_zh = "你等著瞧!!"

[sub_resource type="Resource" id="s24_post_dragon_hmph"]
script = ExtResource("10_line")
character_id = "dragon"
text_zh = "哼!"

[sub_resource type="Resource" id="s24_post_dragon_cool"]
script = ExtResource("10_line")
character_id = "dragon"
text_zh = "看吧! 我帥不帥!"

[sub_resource type="Resource" id="s24_post_villagers_silent"]
script = ExtResource("10_line")
character_id = "villagers"
text_zh = "......"

[sub_resource type="Resource" id="s24_post_villagers_worry"]
script = ExtResource("10_line")
character_id = "villagers"
text_zh = "惹他們生氣的話，可能我們以後都得挨餓了。"

[sub_resource type="Resource" id="s24_post_dragon_what"]
script = ExtResource("10_line")
character_id = "dragon"
text_zh = "什麼??"

[sub_resource type="Resource" id="s24_post_shark_idiot"]
script = ExtResource("10_line")
character_id = "shark"
text_zh = "你個蠢蛋！"

[sub_resource type="Resource" id="s24_post_chop"]
script = ExtResource("10_line")
text_zh = "埃德一個手刀巴在了米洛的頭上。"

[sub_resource type="Resource" id="s24_post_dragon_pain"]
script = ExtResource("10_line")
character_id = "dragon"
text_zh = "痛痛痛!!"

[sub_resource type="Resource" id="s24_post_shark_problem"]
script = ExtResource("10_line")
character_id = "shark"
text_zh = "這下結怨了，明天還用不用跟長老談判了?"

[sub_resource type="Resource" id="s24_post_dragon_this"]
script = ExtResource("10_line")
character_id = "dragon"
text_zh = "這"

[sub_resource type="Resource" id="s24_post_panda_understand"]
script = ExtResource("10_line")
character_id = "panda"
text_zh = "我能理解米洛的想法。事以至此，只能見步走步了。"

[sub_resource type="Resource" id="s24_post_shark_tch"]
script = ExtResource("10_line")
character_id = "shark"
text_zh = "切。"

[sub_resource type="Resource" id="s24_post_gory_good"]
script = ExtResource("10_line")
character_id = "gory"
position = "right"
text_zh = "做得好。我老想[b]扁[/b]他們了。"

[sub_resource type="Resource" id="s24_post_dragon_gory"]
script = ExtResource("10_line")
character_id = "dragon"
text_zh = "戈爾..."

