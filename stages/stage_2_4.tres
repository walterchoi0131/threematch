[sub_resource type="Resource" id="s24_pre_dragon_full"]
script = ExtResource("10_line")
character_id = "dragon"
text_zh = "好飽啊，原來森之國的食物這麼豐盛好吃。"

[sub_resource type="Resource" id="s24_pre_gory_not"]
script = ExtResource("10_line")
character_id = "gory"
position = "right"
text_zh = "不是這樣的。"
action = "enter"

[sub_resource type="Resource" id="s24_pre_gory_poverty"]
script = ExtResource("10_line")
character_id = "gory"
position = "right"
text_zh = "我們的國家，一直陷於貧困飢餓之中。"

[sub_resource type="Resource" id="s24_pre_panda_confused"]
script = ExtResource("10_line")
character_id = "panda"
text_zh = "啊...？"

[sub_resource type="Resource" id="s24_pre_inner_street"]
script = ExtResource("10_line")
text_zh = "戈爾把大家帶到城內一個內街裡。"

[sub_resource type="Resource" id="s24_pre_bg_congee"]
script = ExtResource("10_line")
action = "switch_bg"
background = ExtResource("14_congee")

[sub_resource type="Resource" id="s24_pre_congee"]
script = ExtResource("10_line")
text_zh = "在幽暗的燈光下，城鎮的衛兵在分發稀薄的粥水。"

[sub_resource type="Resource" id="s24_pre_villager_more"]
script = ExtResource("10_line")
character_id = "villager"
text_zh = "抱歉，能再多給一點嗎? 我的孩子也要吃。"

[sub_resource type="Resource" id="s24_pre_guard_rude"]
script = ExtResource("10_line")
character_id = "guard"
position = "right"
text_zh = "嘍哩八嗦的，愛吃不吃，我還趕著下班呢，滾！"

[sub_resource type="Resource" id="s24_pre_push"]
script = ExtResource("10_line")
text_zh = "衛兵用力一推，把村民一下子推倒在地上。白粥也全灑了在地上，現場霎時鴉雀無聲。"

[sub_resource type="Resource" id="s24_pre_shark_tch"]
script = ExtResource("10_line")
character_id = "shark"
text_zh = "切。"

[sub_resource type="Resource" id="s24_pre_panda_help"]
script = ExtResource("10_line")
text_zh = "啊潘馬上衝上攙扶起兔子村民，觀察兔子村民有沒有受傷。"

[sub_resource type="Resource" id="s24_pre_panda_senbei"]
script = ExtResource("10_line")
character_id = "panda"
text_zh = "你沒事吧，我偷拿了一些竹子仙貝，來，給。"

[sub_resource type="Resource" id="s24_pre_shark_hold"]
script = ExtResource("10_line")
character_id = "shark"
text_zh = "米洛，你先別衝動。"

[sub_resource type="Resource" id="s24_pre_shark_grab"]
script = ExtResource("10_line")
text_zh = "埃德請一把抓住米洛的肩，但回頭一眼發現一個人影也沒有。"

[sub_resource type="Resource" id="s24_pre_dragon_angry"]
script = ExtResource("10_line")
character_id = "dragon"
text_zh = "你！太過份了！"

[sub_resource type="Resource" id="s24_pre_guard_foreigner"]
script = ExtResource("10_line")
character_id = "guard"
position = "right"
text_zh = "還是太給你面子了，外鄉人。"

