[sub_resource type="Resource" id="Resource_j70yi"]
script = ExtResource("3_trv1n")
text_zh = "一群人逃離了光之城堡，在數十里外喘息。"
text_en = "Owen's minions pour from the sanctuary halls, surrounding the certificate altar."

[sub_resource type="Resource" id="Resource_l8mxi"]
script = ExtResource("3_trv1n")
character_id = "panda"
text_zh = "應該... 跑得足夠遠了... 不會追來了吧。嗄嗄..."
