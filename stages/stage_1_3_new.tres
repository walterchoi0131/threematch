[sub_resource type="Resource" id="Resource_mtjl6"]
script = ExtResource("3_trv1n")
text_zh = "最後一名爪牙倒下。聖所再次安靜下來。"
text_en = "The last minion falls. The sanctuary is quiet again, but the altar bears the mark of Owen."

[sub_resource type="Resource" id="Resource_gcpha"]
script = ExtResource("3_trv1n")
character_id = "duan"
position = "right"
text_zh = "他們，他們是誰？？"
text_en = "They were not raiding at random. They were searching for something under the altar."
action = "enter"

[sub_resource type="Resource" id="Resource_83b2d"]
script = ExtResource("3_trv1n")
character_id = "dragon"
text_zh = "老師，我們去找老師！！"
text_en = "But the certificates are still here!"
action = "enter"

[sub_resource type="Resource" id="Resource_ywt1l"]
script = ExtResource("3_trv1n")
character_id = "shark"
position = "right"
text_zh = "好，不要慌張，跟我走。"
text_en = "Take them. Then we find out why Owen wanted this place surrounded."

[sub_resource type="Resource" id="Resource_a3886"]
script = ExtResource("3_trv1n")
character_id = "panda"
text_zh = "事情怎麼變成這樣了哎呀呀..."
text_en = "Official adventurers on our first official disaster. That sounds about right."

