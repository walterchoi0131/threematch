[sub_resource type="Resource" id="s22_post_1"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "你們真的不是來搶森林的？好吧，我帶你們去見長老。"
text_en = "You really are not here to steal from the forest? Fine. I will take you to the elder."

[sub_resource type="Resource" id="s22_post_2"]
script = ExtResource("3_line")
character_id = "shark"
position = "right"
text_zh = "合作比互相消耗更有效率。歡迎加入。"
text_en = "Cooperation is more efficient than wasting strength. Welcome aboard."

[sub_resource type="Resource" id="s22_post"]
script = ExtResource("4_seq")
lines = Array[ExtResource("3_line")]([SubResource("s22_post_1"), SubResource("s22_post_2")])
cast = Array[String](["gory", "shark"])
background = ExtResource("5_bg")

[sub_resource type="Resource" id="s22_pre_1"]
script = ExtResource("3_line")
character_id = "gory"
position = "right"
text_zh = "闖入者！這裡不是你們可以亂碰的森林。"
text_en = "Intruders! This forest is not yours to touch."

[sub_resource type="Resource" id="s22_pre_2"]
script = ExtResource("3_line")
character_id = "panda"
text_zh = "我們只是想見長老，順便問問這裡為什麼亮得像午餐盒。"
text_en = "We only want to see the elder, and maybe ask why everything glows like lunch."

[sub_resource type="Resource" id="s22_pre"]
script = ExtResource("4_seq")
lines = Array[ExtResource("3_line")]([SubResource("s22_pre_1"), SubResource("s22_pre_2")])
cast = Array[String](["gory", "panda", "dragon", "shark"])
