[sub_resource type="Resource" id="s27_pre_1"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "Giz！我回來了。這些人不是敵人。"
text_en = "Giz! I am back. These people are not enemies."

[sub_resource type="Resource" id="s27_pre_2"]
script = ExtResource("3_line")
character_id = "giz"
position = "right"
text_zh = "哥哥，別擔心。我還可以把光變成木元素，大家今天會有飯吃。"
text_en = "Do not worry, brother. I can still turn light into leaf energy. Everyone can eat today."

[sub_resource type="Resource" id="s27_pre_3"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "神子不是好東西。你不應該被拿去祭天。"
text_en = "Being chosen is not a blessing. You should not be taken for the sky ritual."

