[sub_resource type="Resource" id="s27_pre_1"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "Giz！我回來了。這些人不是敵人。"
text_en = "Giz! I am back. These people are not enemies."

[sub_resource type="Resource" id="s27_pre_2"]
script = ExtResource("3_line")
character_id = "giz"
position = "right"
text_zh = "哥哥，別擔心。我還可以把光變成木元素，大家今天會有飯吃。"
text_en = "Do not worry, brother. I can still turn light into leaf energy. Everyone can eat today."

[sub_resource type="Resource" id="s27_pre_3"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "神子不是好東西。你不應該被拿去祭天。"
text_en = "Being chosen is not a blessing. You should not be taken for the sky ritual."

[sub_resource type="Resource" id="s27_pre_gory_request"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "在下有一個不請之求"

[sub_resource type="Resource" id="s27_pre_panda_ask"]
script = ExtResource("3_line")
character_id = "panda"
position = "right"
text_zh = "怎麼了戈爾"
action = "enter"

[sub_resource type="Resource" id="s27_pre_gory_giz"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "我想你們幫我救出我的弟弟 Giz"

[sub_resource type="Resource" id="s27_pre_dragon_brother"]
script = ExtResource("3_line")
character_id = "dragon"
position = "right"
text_zh = "你還有弟弟?"
action = "enter"

[sub_resource type="Resource" id="s27_pre_gory_follow"]
script = ExtResource("3_line")
character_id = "gory"
text_zh = "是的, 跟我來"

[sub_resource type="Resource" id="s27_pre_narration_village"]
script = ExtResource("3_line")
text_zh = "[戈爾帶大家走到了一條小村落, 村民們圍著一個年幼的小熊。]"

[sub_resource type="Resource" id="s27_pre_narration_light"]
script = ExtResource("3_line")
text_zh = "[小熊雙手散發著淡淡的金光。]"

[sub_resource type="Resource" id="s27_pre_narration_wood"]
script = ExtResource("3_line")
text_zh = "[木元素不斷從掌心流出, 流淌到周圍的田地與果樹上, 植物重新煥發生機。]"

[sub_resource type="Resource" id="s27_pre_villager_thanks"]
script = ExtResource("3_line")
